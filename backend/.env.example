# Copy to backend/.env and adjust. Never commit a real .env file.

# development | test | production
LABORLINK_ENVIRONMENT=development

# SQLAlchemy URL. Relative SQLite paths are resolved against the backend/ directory.
LABORLINK_DATABASE_URL=sqlite:///./var/laborlink.db

# Where uploaded job photos are stored (relative to backend/). Never inside frontend/.
LABORLINK_UPLOAD_DIR=./var/uploads
LABORLINK_MAX_UPLOAD_BYTES=5242880

# Pricing configuration file (relative to backend/).
LABORLINK_RATE_CARD_PATH=./app/data/rate_card.json

# Comma-separated list of browser origins allowed to call the API.
LABORLINK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Work-order generator: rule_based (default, offline, deterministic) | anthropic
LABORLINK_WORK_ORDER_PROVIDER=rule_based
LABORLINK_ANTHROPIC_MODEL=claude-opus-5-5
LABORLINK_ANTHROPIC_EFFORT=low
LABORLINK_PROVIDER_TIMEOUT_SECONDS=30

# Speech-to-text for voice job descriptions (Sarvam AI, https://dashboard.sarvam.ai).
# Leave unset to use the browser's own speech recognition (Chrome/Edge only).
# SARVAM_API_KEY=your-sarvam-key
# LABORLINK_SARVAM_STT_MODEL=        # empty = Sarvam's default model
LABORLINK_MAX_AUDIO_BYTES=2097152

# Only needed when LABORLINK_WORK_ORDER_PROVIDER=anthropic.
# Read directly by the Anthropic SDK; LaborLink never logs or returns it.
# ANTHROPIC_API_KEY=your-key-here